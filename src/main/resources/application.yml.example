spring:
  application:
    name: trading-platform

  datasource:
    # Uses environment variables or defaults to SSH tunnel (localhost:5432)
    # Prerequisites: SSH tunnel must be running:
    # ssh -L 5432:localhost:5432 ec2-user@10.18.73.92
    # Or set environment variables for other database endpoints:
    # DB_HOST, DB_PORT, DB_NAME, DB_USERNAME, DB_PASSWORD
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:toadstool_db}
    username: ${DB_USERNAME:toadstool_user}
    password: ${DB_PASSWORD:toadstool_password}
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false

  flyway:
    enabled: true
    locations: classpath:db/migration
    table: flyway_schema_history

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.neueda.leap
  type-handlers-package: com.neueda.leap.mapper
  configuration:
    map-underscore-to-camel-case: true

server:
  port: ${SERVER_PORT:8081}

logging:
  level:
    root: INFO
    com.neueda.leap: DEBUG
    org.springframework.web: DEBUG

auth:
  jwt:
    public-key: ${AUTH_JWT_PUBLIC_KEY:BASE64_X509_PUBLIC_KEY}
    private-key: ${AUTH_JWT_PRIVATE_KEY:BASE64_PKCS8_PRIVATE_KEY}
    issuer: toadstool
    access-token-ttl-minutes: 15
    enabled: true
    require-https: ${AUTH_JWT_REQUIRE_HTTPS:false}
