spring:
  application:
    name: trading-platform

  datasource:
    url: jdbc:postgresql://localhost:5432/Toadstool
    username: postgres
    password: YOUR_PASSWORD_HERE
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false

  flyway:
    enabled: true
    locations: classpath:db/migration
    table: flyway_schema_history

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.neueda.leap
  type-handlers-package: com.neueda.leap.mapper
  configuration:
    map-underscore-to-camel-case: true

server:
  port: 8081

logging:
  level:
    root: INFO
    com.neueda.leap: DEBUG
    org.springframework.web: DEBUG
