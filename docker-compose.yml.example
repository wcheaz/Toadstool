services:
  postgres:
    image: postgres:16-alpine
    container_name: toadstool-db
    environment:
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME}
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale=en_US.UTF-8"
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./db/migrations:/docker-entrypoint-initdb.d
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME} -d ${DB_NAME}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - toadstool-network
      - shared-app-network

  api:
    build: .
    container_name: toadstool-api
    environment:
      SERVER_PORT: "8080"
      DB_HOST: postgres
      DB_PORT: "5432"
      DB_NAME: ${DB_NAME:?Set DB_NAME in .env}
      DB_USERNAME: ${DB_USERNAME:?Set DB_USERNAME in .env}
      DB_PASSWORD: ${DB_PASSWORD:?Set DB_PASSWORD in .env}
      REPORTING_DB_HOST: postgres
      REPORTING_DB_PORT: "5432"
      REPORTING_DB_NAME: ${REPORTING_DB_NAME:-toadstool_reporting}
      REPORTING_DB_USERNAME: ${REPORTING_DB_USERNAME:-${DB_USERNAME}}
      REPORTING_DB_PASSWORD: ${REPORTING_DB_PASSWORD:-${DB_PASSWORD}}
      FAUXNANCE_BASE_URL: ${FAUXNANCE_BASE_URL:?Set FAUXNANCE_BASE_URL in .env}
      FAUXNANCE_API_KEY: ${FAUXNANCE_API_KEY:?Set FAUXNANCE_API_KEY in .env}
      FAUXNANCE_TIMEOUT_SECONDS: ${FAUXNANCE_TIMEOUT_SECONDS:-10}
      FINNHUB_API_KEY: ${FINNHUB_API_KEY:?Set FINNHUB_API_KEY in .env}
      AUTH_JWT_PUBLIC_KEY: ${AUTH_JWT_PUBLIC_KEY:-BASE64_X509_PUBLIC_KEY}
      AUTH_JWT_PRIVATE_KEY: ${AUTH_JWT_PRIVATE_KEY:-BASE64_PKCS8_PRIVATE_KEY}
      AUTH_JWT_REQUIRE_HTTPS: ${AUTH_JWT_REQUIRE_HTTPS:-false}
    ports:
      - "8081:8080"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - toadstool-network

  frontend:
    build: ./frontend
    container_name: toadstool-frontend
    ports:
      - "${FRONTEND_PORT:-8082}:8080"
    depends_on:
      - api
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
      interval: 10s
      timeout: 5s
      retries: 3
    networks:
      - toadstool-network

volumes:
  postgres_data:
    driver: local

networks:
  toadstool-network:
    driver: bridge

  # Shared with the separately deployed Superset Compose project.
  shared-app-network:
    external: true
    name: shared-app-network
