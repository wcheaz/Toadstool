# Database Configuration
# Point to the shared VM database or use local Docker container

# Database host (VM IP or 'localhost' for local Docker container)
DB_HOST=10.18.73.92

# Database port (default PostgreSQL port)
DB_PORT=5432

# Database name
DB_NAME=toadstool_db

# Database username (PostgreSQL database user, not SSH user)
DB_USERNAME=toadstool_user

# Database password (IMPORTANT: Set this in your local .env file, never commit!)
DB_PASSWORD=PASSWORD_PLACEHOLDER
