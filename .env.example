# Database Configuration
# Point to the shared VM database via SSH tunnel or use local Docker container

# Database host: Use 'localhost' when SSH tunnel is active
# SSH Tunnel: ssh -L 5432:localhost:5432 ec2-user@10.18.73.92
DB_HOST=localhost

# Database port (default PostgreSQL port)
DB_PORT=5432

# Database name
DB_NAME=toadstool_db

# Database username (PostgreSQL database user, not SSH user)
DB_USERNAME=toadstool_user

# Database password (IMPORTANT: Set this in your local .env file, never commit!)
DB_PASSWORD=PASSWORD_PLACEHOLDER

# Admin/reporting read database (defaults to toadstool_reporting)
# If omitted, the app falls back to DB_USERNAME/DB_PASSWORD for credentials.
REPORTING_DB_HOST=localhost
REPORTING_DB_PORT=5432
REPORTING_DB_NAME=toadstool_reporting
REPORTING_DB_USERNAME=toadstool_user
REPORTING_DB_PASSWORD=PASSWORD_PLACEHOLDER

# Fauxnance API Configuration (for market data and quotes)

# Fauxnance API base URL
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Fauxnance API key (IMPORTANT: Set this in your local .env file, never commit!)
FAUXNANCE_API_KEY=YOUR_API_KEY_HERE

# Fauxnance request timeout in seconds
FAUXNANCE_TIMEOUT_SECONDS=10

# Finnhub API key for live news
FINNHUB_API_KEY=PASSWORD_HERE

# OLTP -> OLAP refresh script configuration (db/scripts/sync_reporting_olap.py)
# Source defaults to DB_* values above unless SOURCE_DB_* is set.
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=toadstool_db
SOURCE_DB_USERNAME=toadstool_user
SOURCE_DB_PASSWORD=PASSWORD_PLACEHOLDER

# Target OLAP database
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=toadstool_reporting
TARGET_DB_USERNAME=toadstool_user
TARGET_DB_PASSWORD=PASSWORD_PLACEHOLDER

# Daily run schedule for market-close refresh (Eastern Time)
MARKET_TIMEZONE=America/New_York
